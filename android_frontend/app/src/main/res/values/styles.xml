<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OceanProfessional" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary_variant</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryVariant">@color/ocean_secondary_variant</item>
        <item name="colorError">@color/ocean_error</item>

        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="android:statusBarColor">@color/ocean_primary_variant</item>
        <item name="android:navigationBarColor">@color/ocean_surface</item>

        <item name="materialCardViewStyle">@style/Widget.Ocean.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Ocean.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.Ocean.FAB.Primary</item>
        <item name="toolbarStyle">@style/Widget.Ocean.TopAppBar</item>
        <item name="android:buttonStyle">@style/Widget.Ocean.Button.Primary</item>
        <item name="editTextStyle">@style/Widget.Ocean.EditText</item>
    </style>

    <style name="Widget.Ocean.TopAppBar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/ocean_surface</item>
        <item name="titleTextColor">@color/ocean_text</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.Ocean.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/ocean_surface</item>
        <item name="itemTextColor">@color/ocean_nav_item_color</item>
        <item name="itemIconTint">@color/ocean_nav_item_color</item>
    </style>

    <style name="Widget.Ocean.BottomNav.ActiveIndicator" parent="">
        <item name="android:color">@color/ocean_primary</item>
    </style>

    <style name="Widget.Ocean.FAB.Primary" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/ocean_primary</item>
        <item name="tint">@color/ocean_on_primary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Small.Rounded</item>
    </style>

    <style name="Widget.Ocean.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ocean_primary</item>
        <item name="android:textColor">@color/ocean_on_primary</item>
        <item name="android:elevation">2dp</item>
        <item name="shapeAppearance">@style/Shape.Small.Rounded</item>
    </style>

    <style name="Widget.Ocean.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ocean_error</item>
        <item name="android:textColor">@color/ocean_on_primary</item>
        <item name="android:elevation">2dp</item>
        <item name="shapeAppearance">@style/Shape.Small.Rounded</item>
    </style>

    <style name="Widget.Ocean.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:background">@color/ocean_surface</item>
        <item name="cardElevation">2dp</item>
        <item name="shapeAppearance">@style/Shape.Medium.Rounded</item>
    </style>

    <style name="Widget.Ocean.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@color/ocean_surface</item>
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <style name="Text.Ocean.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <style name="Text.Ocean.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <style name="Shape.Small.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Medium.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
